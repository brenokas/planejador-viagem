# Copie para .env e preencha:  cp .env.example .env

DB_USER=planejador
# Gere com: openssl rand -base64 24
DB_PASSWORD=troque-esta-senha

# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo

# Chave do Google AI Studio (https://aistudio.google.com/apikey) — usada pelas sugestões e pelo chat
GEMINI_API_KEY=
# Opcional: modelos tentados em ordem (padrão: gemini-3.5-flash-lite,gemini-3.8-flash,gemini-flash-latest)
GEMINI_MODELS=

# Porta exposta na rede local
WEB_PORT=8088
